# ---------------------------------------------------------------------------
# BMW Outreach — environment variables
# Copy this file to `.env.local` (Vercel) and configure Convex env vars.
# ---------------------------------------------------------------------------

# --- Vercel (client-safe, NEXT_PUBLIC_) -------------------------------------
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_WHATSAPP_INVITE_URL=
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=           # placeholder until the intro video is ready
NEXT_PUBLIC_SITE_URL=                   # e.g. https://outreach.icreatitbrandagency.com

# --- Convex (set via `npx convex env set KEY value`) -------------------------
BREVO_API_KEY=                          # Brevo transactional API key
EMAIL_FROM_ADDRESS=outreach@icreatitbrandagency.com
EMAIL_FROM_NAME=BMW Outreach
EMAIL_REPLY_TO=outreach@icreatitbrandagency.com
WHATSAPP_INVITE_URL=                    # same link as NEXT_PUBLIC_ version — keep in sync
